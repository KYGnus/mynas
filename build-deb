#!/bin/bash

###############################################################################
# mynas - One-Step Debian Package Builder
#
# Usage:
#   ./build-deb.sh [path/to/mynas]
#
# Produces:
#   mynas_<version>_all.deb
###############################################################################

set -Eeuo pipefail

trap 'echo ""; echo "[ERROR] Build failed at line $LINENO: $BASH_COMMAND"; exit 1' ERR

###############################################################################
# Config
###############################################################################

APP_NAME="mynas"
VERSION="1.0.1"
ARCH="all"

MAINTAINER="KYGnus <kygnus.co@proton.me>"
DESCRIPTION="Enterprise NAS Management Tool"
HOMEPAGE="https://github.com/KYGnus/mynas"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_SCRIPT="${1:-$SCRIPT_DIR/mynas}"

BUILD_DIR="$SCRIPT_DIR/deb_build"
DEB_ROOT="$BUILD_DIR/${APP_NAME}_${VERSION}_${ARCH}"
OUTPUT_DEB="$SCRIPT_DIR/${APP_NAME}_${VERSION}_${ARCH}.deb"

###############################################################################
# Colors
###############################################################################

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

ok()   { echo -e "${GREEN}[OK]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
err()  { echo -e "${RED}[ERROR]${NC} $1"; }
fail() { err "$1"; exit 1; }

###############################################################################
# Environment checks
###############################################################################

command -v dpkg-deb >/dev/null 2>&1 || fail "dpkg-deb not installed."

[[ -f "$SRC_SCRIPT" ]] || fail "Source script not found: $SRC_SCRIPT"

echo ""
echo "============================================================"
echo "  mynas Debian Package Builder"
echo "============================================================"
echo "  Source : $SRC_SCRIPT"
echo "  Output : $OUTPUT_DEB"
echo ""

###############################################################################
# Clean
###############################################################################

rm -rf "$BUILD_DIR"
rm -f  "$OUTPUT_DEB"

###############################################################################
# Directory layout
###############################################################################

mkdir -p "$DEB_ROOT/DEBIAN"
mkdir -p "$DEB_ROOT/usr/bin"
mkdir -p "$DEB_ROOT/usr/share/doc/$APP_NAME"
mkdir -p "$DEB_ROOT/etc/$APP_NAME"
mkdir -p "$DEB_ROOT/var/log/$APP_NAME"
mkdir -p "$DEB_ROOT/mnt/backups"

###############################################################################
# Install main script
###############################################################################

install -m 0755 "$SRC_SCRIPT" "$DEB_ROOT/usr/bin/$APP_NAME"

# Ensure shebang
if ! head -1 "$DEB_ROOT/usr/bin/$APP_NAME" | grep -q '^#!'; then
    sed -i '1i#!/bin/bash' "$DEB_ROOT/usr/bin/$APP_NAME"
fi

ok "Installed launcher: /usr/bin/$APP_NAME"

###############################################################################
# Default config files
###############################################################################

cat > "$DEB_ROOT/etc/$APP_NAME/groups.conf" <<'EOF'
# Group Configuration
# Format: groupname:user1,user2,user3
EOF

cat > "$DEB_ROOT/etc/$APP_NAME/policies.conf" <<'EOF'
# Access Policies Configuration
# Format: policy_name:group:path:permissions:recursive
# permissions: r=read, w=write, x=execute, l=list, n=none
EOF

cat > "$DEB_ROOT/etc/$APP_NAME/shares.conf" <<'EOF'
# Shares Configuration
# Format: share_name:path:owner_group:access_groups:permissions
EOF

ok "Default configuration files created."

###############################################################################
# Documentation
###############################################################################

cat > "$DEB_ROOT/usr/share/doc/$APP_NAME/README" <<EOF
mynas - Enterprise NAS Management Tool
======================================

Version: $VERSION

Usage
-----

    mynas --help
    mynas --help --[MODULE]

Configuration
-------------

    /etc/$APP_NAME/

Logs
----

    /var/log/$APP_NAME/

Backups
-------

    /mnt/backups/

Homepage
--------

    $HOMEPAGE

Maintainer
----------

    $MAINTAINER
EOF

cat > "$DEB_ROOT/usr/share/doc/$APP_NAME/copyright" <<EOF
Copyright (c) $(date +%Y) KYGnus
$HOMEPAGE
EOF

chmod 644 "$DEB_ROOT/usr/share/doc/$APP_NAME/README"
chmod 644 "$DEB_ROOT/usr/share/doc/$APP_NAME/copyright"

###############################################################################
# DEBIAN/control
###############################################################################

cat > "$DEB_ROOT/DEBIAN/control" <<EOF
Package: $APP_NAME
Version: $VERSION
Section: admin
Priority: optional
Architecture: $ARCH
Maintainer: $MAINTAINER
Depends: bash, coreutils, util-linux, systemd, sudo
Recommends: mdadm, lvm2, nfs-kernel-server, samba, sshfs, firewalld, fail2ban, smartmontools, sysstat, clamav, zip, tar, dosfstools, e2fsprogs, xfsprogs, btrfs-progs
Homepage: $HOMEPAGE
Description: $DESCRIPTION
 mynas is an enterprise-grade NAS management tool that provides
 modules for backup, antivirus, storage, NFS, Samba, SSHFS,
 firewall, fail2ban, RAID, LVM, filesystem, network, service,
 user, group, policy, share, and permission management.
EOF

###############################################################################
# DEBIAN/postinst
###############################################################################

cat > "$DEB_ROOT/DEBIAN/postinst" <<'EOF'
#!/bin/bash

set -e

APP_NAME="mynas"

echo ""
echo "============================================================"
echo "  Installing $APP_NAME"
echo "============================================================"
echo ""

# Ensure runtime directories exist
mkdir -p /etc/$APP_NAME
mkdir -p /var/log/$APP_NAME
mkdir -p /mnt/backups
mkdir -p /tmp/$APP_NAME

# Fix permissions
chmod 755 /etc/$APP_NAME
chmod 755 /var/log/$APP_NAME
chmod 755 /mnt/backups

# Create default config files if missing
[ -f /etc/$APP_NAME/groups.conf ]   || touch /etc/$APP_NAME/groups.conf
[ -f /etc/$APP_NAME/policies.conf ] || touch /etc/$APP_NAME/policies.conf
[ -f /etc/$APP_NAME/shares.conf ]   || touch /etc/$APP_NAME/shares.conf

echo "mynas installed successfully."
echo ""
echo "Run:"
echo "    mynas --help"
echo ""

exit 0
EOF

chmod 755 "$DEB_ROOT/DEBIAN/postinst"

###############################################################################
# DEBIAN/prerm
###############################################################################

cat > "$DEB_ROOT/DEBIAN/prerm" <<'EOF'
#!/bin/bash

set -e

# Nothing to stop - mynas is a CLI tool, not a daemon.

exit 0
EOF

chmod 755 "$DEB_ROOT/DEBIAN/prerm"

###############################################################################
# DEBIAN/postrm
###############################################################################

cat > "$DEB_ROOT/DEBIAN/postrm" <<'EOF'
#!/bin/bash

set -e

if [ "$1" = "purge" ]; then
    rm -rf /etc/mynas
    rm -rf /var/log/mynas
    rm -rf /tmp/mynas
fi

exit 0
EOF

chmod 755 "$DEB_ROOT/DEBIAN/postrm"

###############################################################################
# Permissions
###############################################################################

find "$DEB_ROOT" -type d -exec chmod 755 {} \;
find "$DEB_ROOT" -type f -exec chmod 644 {} \;

chmod 755 "$DEB_ROOT/usr/bin/$APP_NAME"
chmod 755 "$DEB_ROOT/DEBIAN/preinst"  2>/dev/null || true
chmod 755 "$DEB_ROOT/DEBIAN/postinst"
chmod 755 "$DEB_ROOT/DEBIAN/prerm"
chmod 755 "$DEB_ROOT/DEBIAN/postrm"

# Config files must be readable but not executable
chmod 644 "$DEB_ROOT/etc/$APP_NAME/"*.conf

ok "Permissions configured."

###############################################################################
# Build
###############################################################################

echo ""
echo "Building .deb ..."

dpkg-deb --build --root-owner-group "$DEB_ROOT" "$OUTPUT_DEB"

[[ -f "$OUTPUT_DEB" ]] || fail "Generated .deb not found."

SIZE=$(du -h "$OUTPUT_DEB" | cut -f1)

echo ""
echo "============================================================"
echo "  BUILD SUCCESSFUL"
echo "============================================================"
echo ""
echo "  Package : $OUTPUT_DEB"
echo "  Size    : $SIZE"
echo ""
echo "  Install : sudo apt install ./$(basename "$OUTPUT_DEB")"
echo "         or: sudo dpkg -i $(basename "$OUTPUT_DEB")"
echo ""
echo "  Remove  : sudo apt remove $APP_NAME"
echo "         or: sudo dpkg -r $APP_NAME"
echo ""
echo "  Purge   : sudo dpkg -P $APP_NAME"
echo ""

exit 0
