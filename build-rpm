#!/bin/bash

###############################################################################
# mynas - One-Step RPM Package Builder
#
# Usage:
#   ./build-rpm.sh [path/to/mynas]
#
# Produces:
#   mynas-<version>-<release>.noarch.rpm
###############################################################################

set -Eeuo pipefail

trap 'echo ""; echo "[ERROR] Build failed at line $LINENO: $BASH_COMMAND"; exit 1' ERR

###############################################################################
# Config
###############################################################################

APP_NAME="mynas"
VERSION="1.0.1"
RELEASE="1"

MAINTAINER="KYGnus <kygnus.co@proton.me>"
LICENSE="MIT"
SUMMARY="Enterprise NAS Management Tool"
DESCRIPTION="mynas is an enterprise-grade NAS management tool that provides modules for backup, antivirus, storage, NFS, Samba, SSHFS, firewall, fail2ban, RAID, LVM, filesystem, network, service, user, group, policy, share, and permission management."
HOMEPAGE="https://github.com/KYGnus/mynas"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_SCRIPT="${1:-$SCRIPT_DIR/mynas}"

BUILD_DIR="$SCRIPT_DIR/rpm_build"
RPMBUILD_DIR="$BUILD_DIR/rpmbuild"
RPMBUILD_SOURCES="$RPMBUILD_DIR/SOURCES"
RPMBUILD_SPECS="$RPMBUILD_DIR/SPECS"
RPMBUILD_BUILD="$RPMBUILD_DIR/BUILD"
RPMBUILD_RPMS="$RPMBUILD_DIR/RPMS"
RPMBUILD_SRPMS="$RPMBUILD_DIR/SRPMS"

OUTPUT_RPM="$SCRIPT_DIR/${APP_NAME}-${VERSION}-${RELEASE}.noarch.rpm"

###############################################################################
# Colors
###############################################################################

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

ok()   { echo -e "${GREEN}[OK]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
err()  { echo -e "${RED}[ERROR]${NC} $1"; }
fail() { err "$1"; exit 1; }

###############################################################################
# Environment checks
###############################################################################

command -v rpmbuild >/dev/null 2>&1 || fail "rpmbuild not installed. Install 'rpm-build' (Fedora/RHEL) or 'rpm' (Debian/Ubuntu)."

[[ -f "$SRC_SCRIPT" ]] || fail "Source script not found: $SRC_SCRIPT"

echo ""
echo "============================================================"
echo "  mynas RPM Package Builder"
echo "============================================================"
echo "  Source : $SRC_SCRIPT"
echo "  Output : $OUTPUT_RPM"
echo ""

###############################################################################
# Clean
###############################################################################

rm -rf "$BUILD_DIR"
rm -f  "$OUTPUT_RPM"

mkdir -p "$RPMBUILD_SOURCES"
mkdir -p "$RPMBUILD_SPECS"
mkdir -p "$RPMBUILD_BUILD"
mkdir -p "$RPMBUILD_RPMS"
mkdir -p "$RPMBUILD_SRPMS"

###############################################################################
# Stage source tree
###############################################################################

STAGE_ROOT="$BUILD_DIR/stage"
STAGE_TOP="$STAGE_ROOT/${APP_NAME}-${VERSION}"

mkdir -p "$STAGE_TOP"

# Copy the script
install -m 0755 "$SRC_SCRIPT" "$STAGE_TOP/$APP_NAME"

# Ensure shebang
if ! head -1 "$STAGE_TOP/$APP_NAME" | grep -q '^#!'; then
    sed -i '1i#!/bin/bash' "$STAGE_TOP/$APP_NAME"
fi

ok "Staged source script."

###############################################################################
# Create source tarball
###############################################################################

(
    cd "$STAGE_ROOT"
    tar -czf "$RPMBUILD_SOURCES/${APP_NAME}-${VERSION}.tar.gz" "${APP_NAME}-${VERSION}"
)

[[ -f "$RPMBUILD_SOURCES/${APP_NAME}-${VERSION}.tar.gz" ]] || fail "Failed to create source tarball."

ok "Source tarball created."

###############################################################################
# Create spec file
###############################################################################

SPEC_FILE="$RPMBUILD_SPECS/${APP_NAME}.spec"

cat > "$SPEC_FILE" <<EOF
Name:           ${APP_NAME}
Version:        ${VERSION}
Release:        ${RELEASE}%{?dist}
Summary:        ${SUMMARY}

License:        ${LICENSE}
URL:            ${HOMEPAGE}
Source0:        %{name}-%{version}.tar.gz

BuildArch:      noarch
Requires:       bash
Requires:       coreutils
Requires:       util-linux
Requires:       systemd
Requires:       sudo

Recommends:     mdadm
Recommends:     lvm2
Recommends:     nfs-utils
Recommends:     samba
Recommends:     fuse-sshfs
Recommends:     firewalld
Recommends:     fail2ban
Recommends:     smartmontools
Recommends:     sysstat
Recommends:     clamav
Recommends:     zip
Recommends:     tar
Recommends:     e2fsprogs
Recommends:     xfsprogs
Recommends:     btrfs-progs

%global _buildhost localhost

%description
${DESCRIPTION}

%prep
%setup -q

%build
# Nothing to build (pure shell script)

%install
rm -rf %{buildroot}

# Install the main launcher
mkdir -p %{buildroot}%{_bindir}
install -m 0755 %{name} %{buildroot}%{_bindir}/%{name}

# Config directory
mkdir -p %{buildroot}/etc/%{name}

# Default config files
cat > %{buildroot}/etc/%{name}/groups.conf <<'CONF'
# Group Configuration
# Format: groupname:user1,user2,user3
CONF

cat > %{buildroot}/etc/%{name}/policies.conf <<'CONF'
# Access Policies Configuration
# Format: policy_name:group:path:permissions:recursive
# permissions: r=read, w=write, x=execute, l=list, n=none
CONF

cat > %{buildroot}/etc/%{name}/shares.conf <<'CONF'
# Shares Configuration
# Format: share_name:path:owner_group:access_groups:permissions
CONF

# Documentation
mkdir -p %{buildroot}%{_docdir}/%{name}

cat > %{buildroot}%{_docdir}/%{name}/README <<'DOC'
mynas - Enterprise NAS Management Tool
======================================

Usage
-----

    mynas --help
    mynas --help --[MODULE]

Configuration
-------------

    /etc/mynas/

Logs
----

    /var/log/mynas/

Backups
-------

    /mnt/backups/
DOC

cat > %{buildroot}%{_docdir}/%{name}/copyright <<'DOC'
Copyright (c) KYGnus
https://github.com/KYGnus/mynas
DOC

# Runtime directories (ghost)
# Created at install time by %post.

%post
###############################################################################
# Post-install scriptlet
###############################################################################

APP_NAME="mynas"

mkdir -p /etc/$APP_NAME
mkdir -p /var/log/$APP_NAME
mkdir -p /mnt/backups
mkdir -p /tmp/$APP_NAME

chmod 755 /etc/$APP_NAME
chmod 755 /var/log/$APP_NAME
chmod 755 /mnt/backups

[ -f /etc/$APP_NAME/groups.conf ]   || touch /etc/$APP_NAME/groups.conf
[ -f /etc/$APP_NAME/policies.conf ] || touch /etc/$APP_NAME/policies.conf
[ -f /etc/$APP_NAME/shares.conf ]   || touch /etc/$APP_NAME/shares.conf

echo ""
echo "$APP_NAME installed successfully."
echo ""
echo "Run:"
echo "    mynas --help"
echo ""

exit 0

%preun
###############################################################################
# Pre-uninstall scriptlet
###############################################################################

# Nothing to stop - mynas is a CLI tool, not a daemon.
exit 0

%postun
###############################################################################
# Post-uninstall scriptlet
###############################################################################

if [ "\$1" -eq 0 ]; then
    # Keep config and logs on normal uninstall; purge them manually if needed.
    :
fi

exit 0

%files
%{_bindir}/%{name}

%dir /etc/%{name}
%config(noreplace) /etc/%{name}/groups.conf
%config(noreplace) /etc/%{name}/policies.conf
%config(noreplace) /etc/%{name}/shares.conf

%doc %{_docdir}/%{name}/README
%doc %{_docdir}/%{name}/copyright

# Runtime directories as ghosts
%ghost %dir /var/log/%{name}
%ghost %dir /tmp/%{name}

%changelog
* $(LC_ALL=C date "+%a %b %d %Y") ${MAINTAINER} - ${VERSION}-${RELEASE}
- Initial RPM package for mynas ${VERSION}
EOF

[[ -f "$SPEC_FILE" ]] || fail "Failed to create spec file."

ok "Spec file created: $SPEC_FILE"

###############################################################################
# Build
###############################################################################

echo ""
echo "Building .rpm ..."

rpmbuild \
    --define "_topdir $RPMBUILD_DIR" \
    --define "_sourcedir $RPMBUILD_SOURCES" \
    --define "_specdir $RPMBUILD_SPECS" \
    --define "_builddir $RPMBUILD_BUILD" \
    --define "_rpmdir $RPMBUILD_RPMS" \
    --define "_srcrpmdir $RPMBUILD_SRPMS" \
    -bb "$SPEC_FILE"

GENERATED_RPM=$(find "$RPMBUILD_RPMS" -type f -name "${APP_NAME}-${VERSION}-${RELEASE}*.rpm" | head -n 1)

[[ -n "$GENERATED_RPM" && -f "$GENERATED_RPM" ]] || fail "Generated .rpm not found."

cp -f "$GENERATED_RPM" "$OUTPUT_RPM"

[[ -f "$OUTPUT_RPM" ]] || fail "Failed to copy generated .rpm."

SIZE=$(du -h "$OUTPUT_RPM" | cut -f1)

echo ""
echo "============================================================"
echo "  BUILD SUCCESSFUL"
echo "============================================================"
echo ""
echo "  Package : $OUTPUT_RPM"
echo "  Size    : $SIZE"
echo ""
echo "  Install : sudo dnf install ./$(basename "$OUTPUT_RPM")"
echo "         or: sudo rpm -ivh $(basename "$OUTPUT_RPM")"
echo ""
echo "  Remove  : sudo dnf remove $APP_NAME"
echo "         or: sudo rpm -e $APP_NAME"
echo ""

exit 0
